{
  "name": "ladybird",
  "description": "Ladybird browser extension",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:wxt": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run i18n:check && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "i18n:check": "node scripts/check-locales.mjs",
    "i18n:unused-check": "node scripts/check-unused-locales.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
